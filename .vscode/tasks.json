{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: g++ build active file",
      "command": "/usr/bin/g++",
      "args": [
        "-fdiagnostics-color=always",
        "-Wall",
        "-Wextra",
        "-g3",
        "${workspaceFolder}/*.cpp",
        "${workspaceFolder}/class/*.cpp",
        "-o",
        "${workspaceFolder}/output/main"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compila todos os ficheiros .cpp da raiz e da pasta class"
    }
  ]
}